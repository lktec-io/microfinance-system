# ══════════════════════════════════════════════════════════════
# Baraka Microcredit — Server Environment Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────
PORT=8004
NODE_ENV=production

# ── Database (MySQL) ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=microfinance

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_hex
JWT_REFRESH_SECRET=replace_with_another_64_char_random_hex
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS / Frontend ──────────────────────────────────────────
CORS_ORIGIN=https://yourdomain.com
CLIENT_URL=https://yourdomain.com

# ── Email (SMTP — Brevo) ─────────────────────────────────────
# Sign up at https://app.brevo.com → SMTP & API → SMTP tab
# Use your Brevo login email as SMTP_USER.
# Use the Brevo-generated SMTP key (not your account password) as SMTP_PASS.
# SMTP_FROM must be a verified sender in your Brevo account.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login@example.com
SMTP_PASS=your_brevo_smtp_api_key
SMTP_FROM=Baraka Microcredit <noreply@yourdomain.com>

# ── BEEM Africa SMS ───────────────────────────────────────────
BEEM_API_KEY=your_beem_api_key
BEEM_SECRET_KEY=your_beem_secret_key
BEEM_SENDER_ID=YOURSENDERID
